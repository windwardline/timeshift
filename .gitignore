# dependencies
/node_modules
# next.js
/.next/
/out/
/build
# env (never commit real secrets)
.env
.env*.local
# vitest / coverage
/coverage
# playwright (e2e artifacts; the spec + committed screenshots are evidence)
/test-results
/playwright-report
# typescript
*.tsbuildinfo
# misc
.DS_Store
*.pem
npm-debug.log*
.vercel

# Rewritten by `next dev` and `next build` with DIFFERENT contents
# (.next/dev/types/... vs .next/types/...), so tracking it means the file flips
# back and forth for anyone who runs both. `npm run typecheck` regenerates it
# via `next typegen` first, so nothing depends on it being in the checkout.
next-env.d.ts
